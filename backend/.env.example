# Optional backend settings
MONGO_URL=mongodb://localhost:27017
DB_NAME=nokia_launcher
# No browser origin is allowed by default. Use a comma-separated allowlist.
CORS_ORIGINS=https://admin.example.com
CORS_ALLOW_CREDENTIALS=false

# Enables the shared preference administration endpoints. When absent or empty,
# GET/POST /api/apps/preferences fail closed with HTTP 503.
PREFERENCES_ADMIN_TOKEN=replace-with-a-long-random-server-admin-token

# Play Integrity standard-request configuration
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=123456789012
PLAY_INTEGRITY_PACKAGE_NAME=com.nokialauncher
PLAY_INTEGRITY_CHALLENGE_SECRET=replace-with-at-least-24-random-characters

# Use one service-account option. Never commit real credentials.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/play-integrity-service-account.json
# PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
