<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigator_root"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:animateLayoutChanges="false"
    android:background="@drawable/nokia_navigator_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="96dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/navigator_soft_left"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#E8E8DF"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="TAB"
            android:textAllCaps="false"
            android:textColor="#11140F"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navigator_green"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#4E9B58"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="OK"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigator_dpad"
        android:layout_width="240dp"
        android:layout_height="48dp"
        android:clickable="false"
        android:focusable="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navigator_left"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="‹"
            android:textSize="22sp" />

        <Button
            android:id="@+id/navigator_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="↑"
            android:textSize="20sp" />

        <Button
            android:id="@+id/navigator_select"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="●"
            android:textSize="16sp" />

        <Button
            android:id="@+id/navigator_down"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="↓"
            android:textSize="20sp" />

        <Button
            android:id="@+id/navigator_right"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="›"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="96dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/navigator_soft_right"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#E8E8DF"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="BACK"
            android:textAllCaps="false"
            android:textColor="#11140F"
            android:textSize="9sp" />

        <Button
            android:id="@+id/navigator_red"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#A94B43"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="HOME"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
